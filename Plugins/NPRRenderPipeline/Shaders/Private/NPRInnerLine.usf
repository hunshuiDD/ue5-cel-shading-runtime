// 屏幕空间内描边 · SceneViewExtension + RDG 版本（单 Pass）
//
// 算法来自 M_InnerLine 的 Custom 节点（屏幕空间内线描边_实现与TSR位置踩坑_20260727.md §4），
// 搬运时做了两处有依据的修改，都在下面对应位置写明了根因：
//   1) NdotV 改用视空间 Z（旧版误用世界上轴，是脚面/肩部多余线条的头号根因）
//   2) 检测门槛与线条软硬解耦（旧版 smoothstep(Thresh*0.6, Thresh*SoftRange, ..) 两者数学锁死）
//
// ⚠ 曾经有第三条修改「线宽拆到独立的膨胀 Pass」，**2026-08-22 实测判死并已删除**，别再加回来。
// 三档参数全试过，没有一档能得到「连续且不合并」的粗线：
//   软遮罩(Soft 0.3 / Thresh 2.0) + R=1 → 灰晕被一起推开，密集区合并成黑块
//   硬遮罩(Soft 0.02 / Thresh 4.0) + R=1 → 点状虚线
//   中间档(Soft 0.1  / Thresh 2.5) + R=1 → 仍是麻点
// 根因是结构性的：法线梯度沿一条边缘持续波动，任何硬阈值切下去遮罩本身就是碎的。
// EdgeSoftness 的羽化其实在替它做降噪（灰过渡把断点连成视觉上的线），
// 而形态学膨胀恰恰要求干净的二值遮罩 —— 它把羽化推糊、把断点放大成麻点，两头不讨好。
// 结论：max-filter 膨胀与这个边缘检测器先天不兼容，不是调参问题。
// 膨胀既然没了，EdgeMask/Composite 拆两趟就没有意义（中间没有任何跨像素操作，
// 两趟输出与单趟数学等价），故融合为一趟，省掉一次全屏 RT 写 + 一次全屏采样 + 一次 draw。
//
// 取数方式的差异：材质域用 SceneTextureLookup(UV, Id, bFiltered)，这里没有这套宏，
// 改用引擎的 GetGBufferData(UV)，一次取回 WorldNormal / Depth / ShadingModelID / CustomStencil / Metallic。
// 旧版一个 tap 要 lookup 两次（Id 8 + Id 1），各自展开成一次完整 GBuffer 解码；这里一次解码覆盖两者。

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

// 前提：r.Substrate.ProjectGBufferFormat = 0（本项目 DefaultEngine.ini:32）。
// 该格式下 Substrate 仍写传统 GBuffer，所以 GetGBufferData 可用。
// 若改成 1，数据就搬进 Substrate MaterialTextureArray，必须改走
// SubstratePublic_GetSubstrateGBufferFromFirstBSDF —— 而那条路要绑
// FSubstratePublicGlobalUniformParameters，该类型不在 Renderer/Public，插件拿不到。
//
// 这个前提**在 C++ 侧运行时检查**（见 NPRInnerLineSceneViewExtension.cpp 的
// IsSubstrateGBufferFormatSupported），不在这里用 #if/#error 拦。理由有二：
//  1) 运行时检查的失败方式更好 —— 报错一次 + 透传 SceneColor，而不是让整个引擎的
//     全局 shader 编译失败、编辑器起不来。
//  2) 这里原本写的 `#error <中文>` 会让 UE 的 shader 预处理器丢掉条件栈，报出误导性的
//     "No #endif found for previous #if"（2026-08-22 实测）。**#error 本身没问题**
//     （引擎自带 shader 里有 331 处），问题是**预处理指令行不能出现非 ASCII 字符**。
//     注释行不受此限（本文件其余中文注释均正常）。

// ⚠ PS 入口的第一个参数 `noperspective float4 UVAndScreenPos : TEXCOORD0` 不能删，
// 哪怕函数体里一个字都没用到它。
// 配对的 ScreenPassVS（Engine/Shaders/Private/ScreenPass.usf:12-19）按
//   OutUVAndScreenPos : TEXCOORD0  →  register 0
//   OutPosition       : SV_POSITION →  register 1
// 的顺序输出。PS 若只声明 SV_POSITION，它会被分到 register 0，与 VS 对不上，
// D3D12 在 CreateGraphicsPipelineState 直接返回 E_INVALIDARG（0x80070057）：
//   "Semantic 'SV_Position' is defined for mismatched hardware registers
//    between the output stage and input stage."（2026-08-22 -d3ddebug 实测）
// 声明了但不使用的入参仍会保留在 input signature 里，所以占位就够，不必真的读它。

float SampleStride;
float NormalThreshold;
float EdgeSoftness;
float DepthGate;
float GrazingClamp;
float CrossKernelGain;
float FadeStart;
float FadeEnd;
float FootSentinel;
float FootTolerance;
float FootThreshScale;

Texture2D    InputTexture;
SamplerState InputSampler;
float2       InvExtent;
float3       LineColor;
float        LineOpacity;

/**
 * 法线 Sobel + 深度闸门，返回 [0,1] 的边缘强度。
 * 所有“这个像素不该画线”的情形一律返回 0，由调用方统一做合成，
 * 这样早退分支不必各自负责把 SceneColor 原样写回。
 */
float ComputeEdge(float2 UV)
{
	FGBufferData C = GetGBufferData(UV, false);

	// 只画角色。CustomStencil 由角色 SkeletalMeshComponent 写入（Custom Depth-Stencil Pass = Enabled with Stencil）。
	if (C.CustomStencil == 0)
	{
		return 0.0;
	}

	// 跳过脸部。脸是 Unlit，不写有意义的 GBuffer 法线，法线梯度恒为零；
	// 二次元脸部线条走贴图，不由屏幕空间描边负责。
	if (C.ShadingModelID == SHADINGMODELID_UNLIT)
	{
		return 0.0;
	}

	// Sobel 的采样步长（像素）。现役 PPM 版调到了 0.5，故这里保留为可调参数。
	// 它不是“线宽”：加大步长会同时改掉检测灵敏度（旧版的锁死点）。
	// 线宽只能靠 EdgeSoftness 的羽化宽度调 —— 独立的膨胀 Pass 已判死，见文件头。
	const float2 O = SampleStride * View.BufferSizeAndInvSize.zw;

	float3 N[9];
	float  D[9];

#if NPR_SOBEL_9TAP

	// 3x3 全采。i==4 的偏移是 0，编译器会与上面的中心 tap 合并，不额外多一次解码。
	UNROLL
	for (int i = 0; i < 9; ++i)
	{
		const float2 Offset = float2((i % 3) - 1, (i / 3) - 1) * O;
		FGBufferData G = GetGBufferData(UV + Offset, false);
		N[i] = G.WorldNormal;
		D[i] = G.Depth;
	}

	const float3 nx = -N[0] - 2 * N[3] - N[6] + N[2] + 2 * N[5] + N[8];
	const float3 ny = -N[0] - 2 * N[1] - N[2] + N[6] + 2 * N[7] + N[8];
	const float  dx = -D[0] - 2 * D[3] - D[6] + D[2] + 2 * D[5] + D[8];
	const float  dy = -D[0] - 2 * D[1] - D[2] + D[6] + 2 * D[7] + D[8];

#else

	// 十字 5 tap 降级核：只取 上/左/中/右/下。
	// Sobel 的 1-2-1 权重自带平滑，这里没有，对角线边缘上两者量级对不齐，
	// 所以留一个 CrossKernelGain 单独对齐，不要和 9 tap 共用同一组阈值。
	N[4] = C.WorldNormal;
	D[4] = C.Depth;

	UNROLL
	for (int i = 0; i < 4; ++i)
	{
		// 依次对应索引 1(上) 3(左) 5(右) 7(下)
		const int    Index  = (i == 0) ? 1 : ((i == 1) ? 3 : ((i == 2) ? 5 : 7));
		const float2 Offset = float2((Index % 3) - 1, (Index / 3) - 1) * O;
		FGBufferData G = GetGBufferData(UV + Offset, false);
		N[Index] = G.WorldNormal;
		D[Index] = G.Depth;
	}

	const float3 nx = (N[5] - N[3]) * 4.0 * CrossKernelGain;
	const float3 ny = (N[7] - N[1]) * 4.0 * CrossKernelGain;
	const float  dx = (D[5] - D[3]) * 4.0;
	const float  dy = (D[7] - D[1]) * 4.0;

#endif

	// 深度闸门：深度不连续处（外轮廓、自遮挡边）直接放弃，让给壳层描边。
	// 这是两套描边不打架的机制，不是可选的调参项。
	const float DepthGrad = sqrt(dx * dx + dy * dy) / max(D[4], 1.0);
	const float Gate = 1.0 - smoothstep(DepthGate, DepthGate * 2.0, DepthGrad);
	if (Gate < 0.01)
	{
		return 0.0;
	}

	const float NormalGrad = sqrt(dot(nx, nx) + dot(ny, ny));

	// 掠射角补偿。必须用**视空间** Z：
	// 旧 PPM 版写的是 saturate(abs(WorldNormal.z))，那是“朝不朝天”，与视角无关；
	// 配合 GrazingClamp=0.25，朝天面 Thresh×1、朝侧面 Thresh×4，鞋面/肩这类水平面落在超敏感档，
	// 于是冒出一堆不该有的线。方向是常量，世界空间与平移世界空间对它无差别，可直接乘。
	const float3 Nv     = mul(float4(N[4], 0), View.TranslatedWorldToView).xyz;
	const float  NdotV  = saturate(abs(Nv.z));
	float        Thresh = NormalThreshold / max(NdotV, GrazingClamp);

	// 区域遮罩：身体材质在目标区域（如鞋）把 Metallic 写成哨兵值，这里按容差判档并抬高阈值。
	// 抬阈值优于硬屏蔽 —— 鞋与裤脚的分界线还能保留。
	// FootThreshScale 默认 1.0，即整段不起作用；材质侧接好线之后再调到 3.0~5.0。
	const float FootMask = 1.0 - saturate(abs(C.Metallic - FootSentinel) / FootTolerance);
	Thresh *= lerp(1.0, FootThreshScale, FootMask);

	// 距离衰减：远处结构间距 < 1px，内线密度爆炸糊成块，交给壳层外轮廓。
	// 两处生效：抬 Thresh（远处只留最强的结构线）＋ 乘在 Edge 上（整体淡出）。
	const float DistFade = 1.0 - saturate((C.Depth - FadeStart) / max(FadeEnd - FadeStart, 1.0));
	if (DistFade < 0.01)
	{
		return 0.0;
	}
	Thresh /= max(DistFade, 0.1);

	// 解耦后的形状：以 Thresh 为中心，上下各 EdgeSoftness 做羽化。
	// EdgeSoftness→0 得到硬 1px 线，加大只变软，不动检测门槛。
	// 注意它同时在替这个检测器降噪：遮罩本身沿边缘是断续的，羽化的灰过渡把断点连成视觉上的线，
	// 所以调得太硬会看到麻点而不是更细的线（2026-08-22 实测，见文件头）。
	return smoothstep(Thresh - EdgeSoftness, Thresh + EdgeSoftness, NormalGrad) * Gate * DistFade;
}

void InnerLinePS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	// GBuffer 用 View.BufferSizeAndInvSize（场景纹理尺寸），SceneColor 用 InvExtent（该 SRV 的尺寸），
	// 两者当前相同，但来源不同，不要合并成一个。
	const float Edge  = saturate(ComputeEdge(SvPosition.xy * View.BufferSizeAndInvSize.zw) * LineOpacity);
	const float4 Scene = InputTexture.SampleLevel(InputSampler, SvPosition.xy * InvExtent, 0);

	OutColor = float4(lerp(Scene.rgb, LineColor, Edge), Scene.a);
}
